// Complete Prisma Database Schema for Candy Garments / Omnora E-Commerce Architecture
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PaymentType {
  PREPAID_RAAST
  PREPAID_WALLET
  PREPAID_CARD
  COD_WITH_DEPOSIT
}

enum OrderFulfillmentStatus {
  PAYMENT_PENDING
  CONFIRMED_PREPAID
  DEPOSIT_PAID_COD
  VIDEO_INSPECTION_PENDING
  VIDEO_DISPATCHED_TO_CUSTOMER
  IN_TRANSIT
  DELIVERED
  DELIVERY_REFUSED_RTO
  REFUND_REQUESTED
  REFUND_APPROVED
  REFUNDED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID_OUT
}

enum CustomerTrustTier {
  UNVERIFIED       // no completed orders yet, phone not OTP-verified
  STANDARD         // OTP-verified, no refusal history
  TRUSTED          // 3+ completed prepaid or accepted-COD orders
  RESTRICTED       // 2+ COD refusals — COD checkout option hidden
}

model Customer {
  id                String              @id @default(cuid())
  phone             String              @unique
  phoneVerifiedAt   DateTime?
  name              String?
  trustTier         CustomerTrustTier   @default(UNVERIFIED)
  codRefusalCount   Int                 @default(0)
  completedOrders   Int                 @default(0)
  orders            Order[]
  createdAt         DateTime            @default(now())
}

model Product {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String
  basePrice     Decimal          @db.Decimal(10, 2)
  variants      ProductVariant[]
  createdAt     DateTime         @default(now())
}

model ProductVariant {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  size          String
  color         String
  colorHex      String
  imageUrl      String?
  inStock       Boolean      @default(true)
  stockQuantity Int?
  orderItems    OrderItem[]

  @@unique([productId, size, color])
}

model DiscountRule {
  id              String   @id @default(cuid())
  code            String   @unique   // e.g. "PREPAID_AUTO" — admin-editable, not hardcoded
  label           String              // shown to customer, e.g. "Instant Payment Discount"
  percentOff      Decimal? @db.Decimal(5, 2)
  flatAmountOff   Decimal? @db.Decimal(10, 2)
  appliesTo       PaymentType[]       // which payment types auto-qualify
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Order {
  id                    String                 @id @default(cuid())
  orderNumber           Int                    @unique @default(autoincrement())
  customerId            String
  customer              Customer               @relation(fields: [customerId], references: [id])
  customerName          String
  customerPhone         String
  shippingCity          String
  shippingAddress       String
  addressPinLat         Float?
  addressPinLng         Float?

  items                 OrderItem[]
  subtotal              Decimal                @db.Decimal(10, 2)
  discountRuleId        String?
  discountApplied       Decimal                @default(0.00) @db.Decimal(10, 2)
  shippingFee           Decimal                @default(0.00) @db.Decimal(10, 2)
  totalAmount           Decimal                @db.Decimal(10, 2)

  paymentType           PaymentType
  paymentGatewayRef     String?                // Safepay/PayFast transaction id
  paymentWebhookEventId String?                @unique  // idempotency guard — reject duplicate webhook processing
  depositPaid           Decimal                @default(0.00) @db.Decimal(10, 2)
  depositForfeited      Boolean                @default(false)

  otpVerified           Boolean                @default(false)
  otpVerifiedAt         DateTime?

  requiresVideoCheck    Boolean                @default(true)
  dispatchVideoUrl      String?
  videoUploadedAt       DateTime?
  videoUploadedBy       String?                // warehouse staff id
  videoViewedByCustomer Boolean                @default(false)

  trackingNumber        String?
  courierName           String?

  status                OrderFulfillmentStatus @default(PAYMENT_PENDING)
  refundRequests        RefundRequest[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id])
  variantId     String
  variant       ProductVariant  @relation(fields: [variantId], references: [id])
  productName   String          // snapshot at time of order — survives later product edits/deletion
  size          String          // snapshot
  color         String          // snapshot
  unitPrice     Decimal         @db.Decimal(10, 2)
  quantity      Int
}

model RefundRequest {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  reason        String
  evidenceUrls  String[]      // customer-uploaded photos/video of the discrepancy
  status        RefundStatus  @default(REQUESTED)
  slaDeadline   DateTime      // createdAt + 24h, per the SLA promise — used to drive an admin escalation queue
  reviewedBy    String?
  reviewNotes   String?
  payoutRef     String?
  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?
}

model TrustEventLog {
  id            String   @id @default(cuid())
  customerId    String
  eventType     String   // 'COD_REFUSED' | 'COD_ACCEPTED' | 'PREPAID_COMPLETED' | 'OTP_VERIFIED'
  orderId       String?
  createdAt     DateTime @default(now())
}
